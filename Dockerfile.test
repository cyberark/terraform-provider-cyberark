
FROM hashicorp/terraform AS terraform

FROM golang:1.27.3-alpine

# Copy Terraform binary from the terraform stage
COPY --from=terraform /bin/terraform /usr/local/bin/terraform

COPY ssl_cert/* /usr/local/share/ca-certificates/
RUN update-ca-certificates

# Install necessary packages
RUN apk add --no-cache curl \
               gcc \
               git \
               bash \
               mercurial \
               musl-dev \
               jq \
               libc-dev \
               openssl

# Go module proxy. Credentials, when needed, come from the optional gonetrc
# build secret (a .netrc) so they never land in an image layer.
ARG GOPROXY=https://proxy.golang.org,direct
RUN --mount=type=secret,id=gonetrc \
    if [ -s /run/secrets/gonetrc ]; then export NETRC=/run/secrets/gonetrc; fi && \
    go install github.com/jstemmer/go-junit-report@latest && \
    go install github.com/afunix/gocov/gocov@latest && \
    go install github.com/AlekSi/gocov-xml@latest && \
    go install github.com/wadey/gocovmerge@latest

WORKDIR /terraform-provider-cyberark

CMD ["./bin/test-entrypoint.sh"]

EXPOSE 8080
